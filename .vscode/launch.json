{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Game",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd/game",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "output": "${workspaceFolder}/bin/debug/mapp-game",
      "preLaunchTask": "Build Game (All 4 Targets)"
    },
    {
      "name": "Run Game",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd/game",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "output": "${workspaceFolder}/bin/release/mapp-game",
      "preLaunchTask": "Build Game (All 4 Targets)"
    },
    {
      "name": "Run Built Game (Windows)",
      "type": "go",
      "request": "launch",
      "mode": "exec",
      "program": "${workspaceFolder}/build/dist/windows-amd64/mapp-game.exe",
      "cwd": "${workspaceFolder}/build/dist",
      "console": "integratedTerminal",
      "preLaunchTask": "Build Game (All 4 Targets)"
    },
    {
      "name": "Simulation Headless",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/simreport",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "args": [
        "-scenario",
        "${input:simulationScenario}",
        "-turns",
        "${input:simulationTurns}",
        "-player",
        "${input:simulationPlayer}",
        "-seed",
        "${input:simulationSeed}",
        "-difficulty",
        "${input:simulationDifficulty}",
        "-format",
        "markdown",
        "-out",
        "reports/${input:simulationScenario}_${input:simulationTurns}_${input:simulationSeed}.md"
      ],
      "output": "${workspaceFolder}/bin/simreport-debug"
    },
    {
      "name": "Run All Go Tests",
      "type": "node-terminal",
      "request": "launch",
      "command": "go test ./... -count=1",
      "cwd": "${workspaceFolder}"
    }
  ],
  "inputs": [
    {
      "id": "simulationScenario",
      "type": "pickString",
      "description": "Simülasyon senaryosu ?",
      "options": [
        "assets/scenarios/298_war_of_five_kings",
        "assets/scenarios/1300_ottoman_rise",
        "assets/scenarios/1600_thirty_years_war"
      ],
      "default": "assets/scenarios/298_war_of_five_kings"
    },
    {
      "id": "simulationPlayer",
      "type": "pickString",
      "description": "Simülasyon oyuncusu ?",
      "options": [
        "nights_watch",
        "ottoman",
        "habsburg"
      ],
      "default": "nights_watch"
    },
    {
      "id": "simulationTurns",
      "type": "promptString",
      "description": "Kaç tur simüle edilsin ?",
      "default": "100"
    },
    {
      "id": "simulationSeed",
      "type": "promptString",
      "description": "Simülasyon seed'i ?",
      "default": "${random:uuid}"
    },
    {
      "id": "simulationDifficulty",
      "type": "promptString",
      "description": "Simülasyon zorluk seviyesi ?",
      "default": "3"
    }
  ]
}
