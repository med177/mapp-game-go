{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Game",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd/game",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "output": "${workspaceFolder}/bin/debug/mapp-game"
    },
    {
      "name": "Run Game",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd/game",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "output": "${workspaceFolder}/bin/release/mapp-game"
    },
    {
      "name": "Simulation 1300",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/simreport",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "args": [
        "-scenario",
        "assets/scenarios/1300_ottoman_rise",
        "-turns",
        "${input:simulationTurns}",
        "-player",
        "ottoman",
        "-seed",
        "${input:simulationSeed}",
        "-difficulty",
        "3",
        "-format",
        "markdown",
        "-out",
        "reports/1300_ottoman_rise_headless_seed_${input:simulationSeed}_turn_report.md"
      ],
      "output": "${workspaceFolder}/bin/simreport-debug"
    },
    {
      "name": "Simulation 298",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/simreport",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "args": [
        "-scenario",
        "assets/scenarios/298_war_of_five_kings",
        "-turns",
        "${input:simulationTurns}",
        "-player",
        "nights_watch",
        "-seed",
        "${input:simulationSeed}",
        "-difficulty",
        "3",
        "-format",
        "markdown",
        "-out",
        "reports/298_war_of_five_kings_headless_seed_${input:simulationSeed}_turn_report.md"
      ],
      "output": "${workspaceFolder}/bin/simreport-debug"
    },
    {
      "name": "Run All Go Tests",
      "type": "node-terminal",
      "request": "launch",
      "command": "go test ./... -count=1",
      "cwd": "${workspaceFolder}"
    }
  ],
  "inputs": [
    {
      "id": "simulationTurns",
      "type": "promptString",
      "description": "Kaç tur simüle edilsin?",
      "default": "100"
    },
    {
      "id": "simulationSeed",
      "type": "promptString",
      "description": "Simülasyon seed'i?",
      "default": "13100301"
    }
  ]
}
